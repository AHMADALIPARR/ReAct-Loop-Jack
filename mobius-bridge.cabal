cabal-version: 2.4
name: mobius-bridge
version: 0.1.0.0
synopsis: Cycle-Stealing Invariant — Liquid Haskell GHC-plugin gate + IO shell
description:
  The SluiceState / CycleInvariant / executeBatch preservation theorem
  (MobiusBridge) with an IO shell (Main) whose build is gated by the
  Liquid Haskell GHC plugin: if the SMT solver cannot prove the
  GoodState implication, GHC halts and refuses to emit the binary.
license: LicenseRef-Sovereign-Leviathan-SL-AGPL3-001
license-file: LICENSE
author: Ahmad Ali Parr
maintainer: ahmad.parr@snapkittywest.com
build-type: Simple
category: Distributed Computing

flag verify
  description: Require the Liquid Haskell invariant gate during compilation
  default: True
  manual: True

executable mobius-worker
  main-is: Main.hs
  other-modules:
    MobiusBridge,
    Quaternion
  ghc-options:
    -static
    -threaded
    -rtsopts
    "-with-rtsopts=-N"
  cc-options: -static
  ld-options: -static -pthread
  hs-source-dirs: src
  default-language: Haskell2010
  build-depends:
    base >= 4.13 && < 5,
    bytestring,
    network
  if flag(verify)
    build-depends: liquidhaskell
    ghc-options: -fplugin=LiquidHaskell -fplugin-opt=LiquidHaskell:--no-termination

source-repository head
  type: git
  location: https://github.com/AHMADALIPARR/mobius-bridge.git
